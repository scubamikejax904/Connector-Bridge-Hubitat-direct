/* --------------------------------------------------
EASY DASHBOARD COMPATIBILITY
-------------------------------------------------- */
def on() {
    logInfo "Switch ON command received (opening TDBU blind)"
    open()
}

def off() {
    logInfo "Switch OFF command received (closing TDBU blind)"
    close()
}

def open() {
    logInfo "Open command received"
    openTop()
    openBottom()
}

def close() {
    logInfo "Close command received"
    closeTop()
    closeBottom()
}

def stop() {
    logInfo "Stop command received"
    stopTop()
    stopBottom()
}

/* --------------------------------------------------
INITIALIZATION
-------------------------------------------------- */
def installed() {
    logInfo "Child device installed"
    initialize()
}

def updated() {
    logInfo "Child device updated"
    initialize()
}

def initialize() {
    sendEvent(name: "windowShade", value: "unknown")
    sendEvent(name: "level", value: 0)
    sendEvent(name: "position", value: 0)
    sendEvent(name: "levelTop", value: 0)
    sendEvent(name: "levelBottom", value: 0)
    sendEvent(name: "moving", value: "false")
    sendEvent(name: "movingTop", value: "false")
    sendEvent(name: "movingBottom", value: "false")
    sendEvent(name: "switch", value: "off")

    state.tdbuMovementState = [
        top: [ isMoving: false, direction: null, startPosition: null, targetPosition: null, startTime: null, estimatedDuration: null ],
        bottom: [ isMoving: false, direction: null, startPosition: null, targetPosition: null, startTime: null, estimatedDuration: null ]
    ]
    
    logInfo "Initialized with Full Travel Time: ${fullTravelTime}s (Hubitat logic: 100=Open, 0=Closed)"
}

