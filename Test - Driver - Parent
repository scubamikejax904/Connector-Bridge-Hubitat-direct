/* --------------------------------------------------
   TOKEN & QUEUE MANAGEMENT
-------------------------------------------------- */
def queueCommand(String commandName, Map args) {
    logDebug "Queueing command: ${commandName} with args: ${args}"

    def queue = state.commandQueue ?: []
    queue << [command: commandName, arguments: args]
    state.commandQueue = queue

    if (!state.token) {
        discoverDevices()
    } else {
        processCommandQueue()
    }
}

def processCommandQueue() {
    if (state.queuePaused) {
        logDebug "Queue paused during token refresh, skipping"
        return
    }

    def queue = state.commandQueue ?: []
    if (queue.size() == 0) {
        logDebug "Command queue is empty."
        return
    }

    logDebug "Processing ${queue.size()} command(s) from queue."
    state.commandQueue = []

    queue.each { cmdInfo ->
        logDebug "Executing from queue: ${cmdInfo.command}"
        this."${cmdInfo.command}"(cmdInfo.arguments)
    }
}

