/* --------------------------------------------------
   ACCESS TOKEN CALCULATION
   Fixed to match official motion-blinds library
   Uses PKCS5Padding instead of manual zero-padding
   Same algorithm works for both DD7002B and DD7006A
-------------------------------------------------- */
def generateAccessToken(token) {
    if (!bridgeKey || !token) {
        log.error "Cannot generate AccessToken: missing key or token"
        return null
    }


try {
    SecretKeySpec skeySpec = new SecretKeySpec(bridgeKey.getBytes("UTF-8"), "AES")
    Cipher cipher = Cipher.getInstance("AES/ECB/PKCS5Padding")
    cipher.init(Cipher.ENCRYPT_MODE, skeySpec)

    byte[] tokenBytes = token.getBytes("UTF-8")
    
    // Encrypt directly - PKCS5Padding handles padding automatically
    // This matches the official motion-blinds Python library behavior
    byte[] encrypted = cipher.doFinal(tokenBytes)

    String hex = HexUtils.byteArrayToHexString(encrypted).toUpperCase()
    
    // Apply conditional truncation based on detected hub type
    String finalAccessToken = hex
    if (state.detectedHubType?.contains("DD7006")) {
        // Truncate for DD7006, assuming the first 32 characters (128 bits) are required.
        // If this length is incorrect, it needs to be adjusted based on official documentation.
        finalAccessToken = hex.substring(0, 32)
        logDebug "Truncated AccessToken for DD7006: ${finalAccessToken}"
    }

    // Show full AccessToken in debug logs for troubleshooting
    logDebug "Generated AccessToken (full): ${hex}"
    logDebug "Input token (from bridge): ${token}"
    logDebug "Bridge key used: ${bridgeKey}"
    return finalAccessToken

} catch (Exception e) {
    log.error "Encryption Error: ${e.message}"
    return null
}

}


/* --------------------------------------------------
   UDP SEND
-------------------------------------------------- */
def sendUdp(Map message) {
    String json = JsonOutput.toJson(message)


// Track pending requests by msgID
if (message.msgID) {
    def pending = state.pendingMsgIDs ?: []
    pending << [id: message.msgID, sent: now()]
    // Keep only last 10 pending requests
    if (pending.size() > 10) {
        pending = pending[-10..-1]
    }
    state.pendingMsgIDs = pending
}

// Always show full message in debug logs (including AccessToken)
logDebug "UDP -> ${json}"

def action = new hubitat.device.HubAction(
    HexUtils.byteArrayToHexString(json.getBytes("UTF-8")),
    hubitat.device.Protocol.LAN,
    [
        type: hubitat.device.HubAction.Type.LAN_TYPE_UDPCLIENT,
        destinationAddress: "${bridgeIp}:32100",
        encoding: hubitat.device.HubAction.Encoding.HEX_STRING
    ]
)
sendHubCommand(action)

}


/* --------------------------------------------------
   PARSE - Main message handler
-------------------------------------------------- */
def parse(String description) {
    def msg = parseLanMessage(description)
    if (!msg?.payload) return
    String jsonString = new String(HexUtils.hexStringToByteArray(msg.payload), "UTF-8")


// Always show full message in debug logs (including token)
logDebug "UDP Received: ${jsonString}"

def json = new JsonSlurper().parseText(jsonString)

switch(json.msgType) {
    case "GetDeviceListAck":
        handleGetDeviceListAck(json)
        break
        
    case "Heartbeat":
        handleHeartbeat(json)
        break
        
    case "WriteDeviceAck":
        handleWriteDeviceAck(json)
        break
        
    case "ReadDeviceAck":
        handleReadDeviceAck(json)
        break
        
    case "Report":
        handleReport(json)
        break
        
    default:
        logDebug "Unknown message type: ${json.msgType}"
}

}


/* --------------------------------------------------
   MESSAGE HANDLERS
-------------------------------------------------- */
def handleGetDeviceListAck(Map json) {
    state.token = json.token
    state.tokenTimestamp = now()
    log.info "Session token acquired/refreshed."


// Store bridge info
state.bridgeInfo = [
    mac: json.mac,
    deviceType: json.deviceType,
    protocolVersion: json.ProtocolVersion
]

// Detect hub type from response
detectHubType(json)

processCommandQueue()

// Track discovered MACs for cleanup
def discoveredMacs = []

json.data.each { device ->
    // Create children for all device types we can control
    if (device.deviceType in ["10000000", "10000001", "22000000", "22000002", "22000005"]) {
        createChild(device)
        discoveredMacs << device.mac
    }
}

// Clean up children that are no longer reported
cleanupMissingChildren(discoveredMacs)

}


def handleHeartbeat(Map json) {
    log.info "Heartbeat received."


// Update token if provided
if (json.token) {
    state.token = json.token
    state.tokenTimestamp = now()
}

// Update bridge status info
if (json.data) {
    def bridgeStates = getBridgeStates()
    state.bridgeInfo = state.bridgeInfo ?: [:]
    state.bridgeInfo.currentState = json.data.currentState
    state.bridgeInfo.numberOfDevices = json.data.numberOfDevices
    state.bridgeInfo.RSSI = json.data.RSSI
    
    // Send events for bridge status
    sendEvent(name: "bridgeState", value: bridgeStates[json.data.currentState] ?: "Unknown")
    sendEvent(name: "deviceCount", value: json.data.numberOfDevices)
    sendEvent(name: "bridgeRSSI", value: json.data.RSSI)
    
    logDebug "Bridge state: ${bridgeStates[json.data.currentState]}, Devices: ${json.data.numberOfDevices}, RSSI: ${json.data.RSSI}"
}

}


def handleWriteDeviceAck(Map json) {
    if (json.actionResult == "AccessToken error") {
        log.warn "AccessToken error \u2014 refreshing token"
        state.token = null
        state.tokenTimestamp = null
        discoverDevices()
        return
    }


log.info "WriteDeviceAck received for ${json.mac}"

// Process device status from response
if (json.data) {
    updateDeviceStatus(json.mac, json.data)
}

}


def handleReadDeviceAck(Map json) {
    log.info "ReadDeviceAck received for ${json.mac}"


// Process device status
if (json.data) {
    updateDeviceStatus(json.mac, json.data)
}

}


def handleReport(Map json) {
    log.info "Report received for ${json.mac}"


// Process device status
if (json.data) {
    updateDeviceStatus(json.mac, json.data)
}

}


/* --------------------------------------------------
   DEVICE STATUS UPDATE
-------------------------------------------------- */
def updateDeviceStatus(String mac, Map data) {
    def child = getChildDevice(mac)
    if (!child) {
        logDebug "No child device found for ${mac}"
        return
    }


// Store device info
def deviceInfo = state.deviceInfo ?: [:]
deviceInfo[mac] = data
state.deviceInfo = deviceInfo

// Check if TDBU device
def isTDBU = (data.type == 9)

if (isTDBU) {
    updateTDBUDeviceStatus(child, data)
} else {
    updateStandardDeviceStatus(child, data)
}

// Always update lastSeen
child.sendEvent(name: "lastSeen", value: new Date().toString())

}


def updateStandardDeviceStatus(child, Map data) {
    def blindTypes = getBlindTypes()
    def operationTypes = getOperationTypes()
    def currentStates = getCurrentStates()
    def voltageModes = getVoltageModes()
    def wirelessModes = getWirelessModes()


// Position
def pos = data.currentPosition as Integer
def currentLevel = child.currentValue("level")
if (currentLevel != pos) {
    child.sendEvent(name: "level", value: pos)
}

// Window shade state
def currentShade = child.currentValue("windowShade")
def shadeValue = (pos == 0) ? "open" : (pos == 100) ? "closed" : "partially open"
if (currentShade != shadeValue) {
    child.sendEvent(name: "windowShade", value: shadeValue)
}

// Angle (for Venetian/Vertical blinds)
if (data.currentAngle != null) {
    child.sendEvent(name: "angle", value: data.currentAngle as Integer)
}

// Blind type
if (data.type != null) {
    def blindName = blindTypes[data.type] ?: "Unknown"
    child.updateDataValue("blindType", data.type.toString())
    child.updateDataValue("blindTypeName", blindName)
}

// Operation status
if (data.operation != null) {
    child.sendEvent(name: "operation", value: operationTypes[data.operation] ?: data.operation)
}

// Current state (limits)
if (data.currentState != null) {
    child.sendEvent(name: "limitState", value: currentStates[data.currentState] ?: data.currentState)
}

// Voltage mode (AC/DC)
if (data.voltageMode != null) {
    def voltageModeName = voltageModes[data.voltageMode] ?: "Unknown"
    child.updateDataValue("voltageMode", data.voltageMode.toString())
    child.updateDataValue("voltageModeName", voltageModeName)
}

// Battery level (DC motors only)
if (data.batteryLevel != null) {
    child.sendEvent(name: "batteryLevel", value: data.batteryLevel)
    
    // Calculate battery percentage (typical range 700-850 for DC motors)
    def batteryPercent = Math.min(100, Math.max(0, ((data.batteryLevel - 700) / 150 * 100) as Integer))
    child.sendEvent(name: "battery", value: batteryPercent)
}

// Charging state
if (data.chargingState != null) {
    def isCharging = (data.chargingState == 1)
    child.sendEvent(name: "chargingState", value: isCharging ? "charging" : "not charging")
}

// Wireless mode
if (data.wirelessMode != null) {
    def wirelessModeName = wirelessModes[data.wirelessMode] ?: "Unknown"
    child.updateDataValue("wirelessMode", data.wirelessMode.toString())
    child.updateDataValue("wirelessModeName", wirelessModeName)
    
    // Bi-directional capability flag
    child.updateDataValue("isBiDirectional", (data.wirelessMode == 1) ? "true" : "false")
}

// RSSI (signal strength)
if (data.RSSI != null) {
    child.sendEvent(name: "rssi", value: data.RSSI)
}

}


def updateTDBUDeviceStatus(child, Map data) {
    def operationTypes = getOperationTypes()
    def currentStates = getCurrentStates()


// Top position
def posTop = data.currentPosition_T as Integer
child.sendEvent(name: "levelTop", value: posTop)

// Bottom position
def posBottom = data.currentPosition_B as Integer
child.sendEvent(name: "levelBottom", value: posBottom)

// Main level (average or primary)
def avgPos = ((posTop + posBottom) / 2) as Integer
child.sendEvent(name: "level", value: avgPos)

// Window shade state (based on bottom position)
def shadeValue = (posBottom == 0) ? "open" : (posBottom == 100) ? "closed" : "partially open"
child.sendEvent(name: "windowShade", value: shadeValue)

// Operation status
if (data.operation_T != null) {
    child.sendEvent(name: "operationTop", value: operationTypes[data.operation_T] ?: data.operation_T)
}
if (data.operation_B != null) {
    child.sendEvent(name: "operationBottom", value: operationTypes[data.operation_B] ?: data.operation_B)
}

// Current states
if (data.currentState_T != null) {
    child.sendEvent(name: "limitStateTop", value: currentStates[data.currentState_T] ?: data.currentState_T)
}
if (data.currentState_B != null) {
    child.sendEvent(name: "limitStateBottom", value: currentStates[data.currentState_B] ?: data.currentState_B)
}

// Battery levels
if (data.batteryLevel_T != null) {
    child.sendEvent(name: "batteryLevelTop", value: data.batteryLevel_T)
}
if (data.batteryLevel_B != null) {
    child.sendEvent(name: "batteryLevelBottom", value: data.batteryLevel_B)
}

// RSSI
if (data.RSSI != null) {
    child.sendEvent(name: "rssi", value: data.RSSI)
}

// Mark as TDBU
child.updateDataValue("isTDBU", "true")
child.updateDataValue("blindType", "9")
child.updateDataValue("blindTypeName", "TDBU")

}


/* --------------------------------------------------
   OFFLINE DETECTION
-------------------------------------------------- */
def checkOffline() {
    // Skip if offline detection is disabled (timeout = 0 or null)
    if (offlineTimeout == null || offlineTimeout == 0) {
        return
    }


def timeoutSeconds = offlineTimeout * 60

getChildDevices().each { child ->
    def last = child.currentValue("lastSeen")
    if (!last) return
    def diff = (now() - Date.parse("EEE MMM dd HH:mm:ss z yyyy", last).time) / 1000
    
    if (diff > timeoutSeconds && child.currentValue("windowShade") != "unknown") {
        log.warn "Device ${child.deviceNetworkId} has not been seen for over ${offlineTimeout} minute(s). It may be offline."
    }
}

}


/* -------------------------------------------------- */
def refresh() {
    getChildDevices().each {
        refreshChild(it.deviceNetworkId)
    }
}


def logDebug(msg) {
    if (debugLogging) log.debug "[Connector] ${msg}"
}
