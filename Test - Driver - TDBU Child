/**
Connector TDBU Child Driver - Easy Dashboard Compatible
For: TDBU Blinds (9) - Top-Down/Bottom-Up
Commands: TDBU-specific (top/bottom positions)
Test v27 - Position inversion added (Bridge 0=Open ↔ Hubitat 100=Open)
DD7002B & DD7006 Compatible - Fixed type coercion issues
*/
metadata {
    definition(name: "Connector TDBU Child",
    namespace: "connector",
    author: "Scubamikejax904 & Manus",
    //importUrl: "https://raw.githubusercontent.com/connector/hubitat/main/connector-tdbu-child.groovy"
)
    {
        capability "WindowShade"
        capability "Actuator"
        capability "Refresh"
        capability "Battery"
        capability "SignalStrength"
        capability "Switch"
        capability "Sensor"
        
        command "setPosition", [[name: "position", type: "NUMBER", description: "Position 0-100 (sets both)"]]
        command "setTDBUPosition", [
            [name: "positionTop", type: "NUMBER", description: "Top position 0-100"],
            [name: "positionBottom", type: "NUMBER", description: "Bottom position 0-100"]
        ]
        command "setTopPosition", [[name: "position", type: "NUMBER", description: "Top position 0-100"]]
        command "setBottomPosition", [[name: "position", type: "NUMBER", description: "Bottom position 0-100"]]
        command "openTop"
        command "closeTop"
        command "stopTop"
        command "openBottom"
        command "closeBottom"
        command "stopBottom"
        command "on"
        command "off"

        attribute "windowShade", "enum", ["open", "closed", "partially open", "unknown"]
        attribute "level", "number"
        attribute "position", "number"
        attribute "levelTop", "number"
        attribute "levelBottom", "number"
        attribute "positionTop", "number"
        attribute "positionBottom", "number"
        attribute "movingTop", "enum", ["true", "false"]
        attribute "movingBottom", "enum", ["true", "false"]
        attribute "moving", "enum", ["true", "false"]
        attribute "etaTop", "number"
        attribute "etaBottom", "number"
        attribute "eta", "number"
        attribute "lastSeen", "string"
        attribute "rssi", "number"
        attribute "batteryLevelTop", "number"
        attribute "batteryLevelBottom", "number"
        attribute "batteryLevel", "number"
        attribute "battery", "number"
        attribute "blindTypeName", "string"
        attribute "switch", "enum", ["on", "off"]
    }

    tiles {
        valueTile("level", "device.level", inactiveLabel: false, decoration: "flat") {
            state "default", label: '${currentValue}%', action: "setPosition", 
                range: "(0..100)", backgroundColors: [
                    [value: 0, color: "#FF0000"],
                    [value: 50, color: "#FFFF00"],
                    [value: 100, color: "#44D62C"]
                ]
        }
        
        valueTile("levelTop", "device.levelTop", inactiveLabel: false, decoration: "flat") {
            state "default", label: 'Top: ${currentValue}%', action: "setTopPosition", range: "(0..100)"
        }
        
        valueTile("levelBottom", "device.levelBottom", inactiveLabel: false, decoration: "flat") {
            state "default", label: 'Bottom: ${currentValue}%', action: "setBottomPosition", range: "(0..100)"
        }
        
        standardTile("windowShade", "device.windowShade", inactiveLabel: false, decoration: "flat") {
            state "open", label: "Open", action: "open", icon: "st.window-shade.open", backgroundColor: "#44D62C"
            state "closed", label: "Closed", action: "close", icon: "st.window-shade.closed", backgroundColor: "#FF0000"
            state "partially open", label: "Partial", action: "setPosition", icon: "st.window-shade.partial", backgroundColor: "#FFFF00"
            state "unknown", label: "Unknown", icon: "st.window-shade.unknown", backgroundColor: "#CCCCCC"
        }
        
        standardTile("refresh", "device.switch", inactiveLabel: false, decoration: "flat", width: 2, height: 1) {
            state "default", label: "", action: "refresh.refresh", icon: "st.secondary.refresh"
        }
        
        valueTile("battery", "device.battery", inactiveLabel: false, decoration: "flat") {
            state "default", label: '${currentValue}% battery'
        }
        
        valueTile("rssi", "device.rssi", inactiveLabel: false, decoration: "flat") {
            state "default", label: 'RSSI: ${currentValue}'
        }
        
        main(["level", "windowShade"])
        details(["level", "levelTop", "levelBottom", "windowShade", "battery", "rssi", "refresh"])
    }

    preferences {
        input name: "fullTravelTime", type: "number", title: "Full Travel Time (seconds for 0↔100)", defaultValue: 30, range: "5..300"
        input name: "interpolationEnabled", type: "bool", title: "Enable Position Interpolation", defaultValue: true
        input name: "interpolationInterval", type: "number", title: "Interpolation Update Interval (seconds)", defaultValue: 1, range: "1..10"
        input name: "invertPosition", type: "bool", title: "⚙️ Invert Position (Bridge 0=Open ↔ Hubitat 100=Open)", 
            defaultValue: true, description: "Enable if bridge reports 0=fully open, 100=fully closed"
        input name: "debugLogging", type: "bool", title: "Enable Debug Logging", defaultValue: false
        input name: "easyDashboardTemplate", type: "enum", title: "Easy Dashboard Template", 
            options: ["dual-slider": "Dual Slider (Top/Bottom)", "single-slider": "Single Slider (Average)", "buttons": "Buttons Only", "minimal": "Status Only"], 
            defaultValue: "dual-slider"
    }
}

/* --------------------------------------------------
EASY DASHBOARD COMPATIBILITY
-------------------------------------------------- */
def on() {
    logInfo "Switch ON command received (opening TDBU blind)"
    open()
}

def off() {
    logInfo "Switch OFF command received (closing TDBU blind)"
    close()
}

def open() {
    logInfo "Open command received"
    openTop()
    openBottom()
}

def close() {
    logInfo "Close command received"
    closeTop()
    closeBottom()
}

def stop() {
    logInfo "Stop command received"
    stopTop()
    stopBottom()
}

/* --------------------------------------------------
INITIALIZATION
-------------------------------------------------- */
def installed() {
    logInfo "Child device installed"
    initialize()
}

def updated() {
    logInfo "Child device updated"
    initialize()
}

def initialize() {
    sendEvent(name: "windowShade", value: "unknown")
    sendEvent(name: "level", value: 0)
    sendEvent(name: "position", value: 0)
    sendEvent(name: "levelTop", value: 0)
    sendEvent(name: "levelBottom", value: 0)
    sendEvent(name: "moving", value: "false")
    sendEvent(name: "movingTop", value: "false")
    sendEvent(name: "movingBottom", value: "false")
    sendEvent(name: "switch", value: "off")

    state.tdbuMovementState = [
        top: [ isMoving: false, direction: null, startPosition: null, targetPosition: null, startTime: null, estimatedDuration: null ],
        bottom: [ isMoving: false, direction: null, startPosition: null, targetPosition: null, startTime: null, estimatedDuration: null ]
    ]
    
    logInfo "Initialized with Full Travel Time: ${fullTravelTime}s, Invert: ${invertPosition}"
}

/* --------------------------------------------------
POSITION INVERSION HELPER
-------------------------------------------------- */
private Integer invertIfNeeded(Integer position) {
    if (position == null) return null
    return invertPosition ? (100 - position) : position
}

/* --------------------------------------------------
TDBU MOVEMENT TRACKING
-------------------------------------------------- */
def startTDBUMovementTracking(String part, String direction) {
    if (!interpolationEnabled) return

    def currentPos = ((part == "top") ? (device.currentValue("levelTop") ?: 0) : (device.currentValue("levelBottom") ?: 0)) as Integer
    // Hubitat logic: open=100, close=0
    def targetPos = ((direction == "open") ? 100 : 0) as Integer
    
    def distance = Math.abs(targetPos - currentPos) as Integer
    def travelTime = fullTravelTime as long
    def estimatedDuration = (distance > 0) ? (travelTime * ((distance as double) / 100.0) * 1000) as long : 0L
    estimatedDuration = Math.max(1000L, estimatedDuration)

    state.tdbuMovementState[part] = [
        isMoving: true,
        direction: direction,
        startPosition: currentPos,
        targetPosition: targetPos,
        startTime: now(),
        estimatedDuration: estimatedDuration
    ]

    sendEvent(name: "moving${part.capitalize()}", value: "true")
    sendEvent(name: "eta${part.capitalize()}", value: (estimatedDuration / 1000) as Integer)
    updateCombinedMovingState()

    logInfo "TDBU ${part} movement: ${direction} from ${currentPos} to ${targetPos}"
    unschedule("interpolateTDBUPosition")
    runInMillis(interpolationInterval * 1000, "interpolateTDBUPosition")
}

def stopTDBUMovementTracking(String part) {
    state.tdbuMovementState[part].isMoving = false
    state.tdbuMovementState[part].direction = null
    sendEvent(name: "moving${part.capitalize()}", value: "false")
    sendEvent(name: "eta${part.capitalize()}", value: 0)
    updateCombinedMovingState()
}

def updateCombinedMovingState() {
    def topMoving = state.tdbuMovementState?.top?.isMoving ?: false
    def bottomMoving = state.tdbuMovementState?.bottom?.isMoving ?: false
    def anyMoving = topMoving || bottomMoving
    
    sendEvent(name: "moving", value: anyMoving ? "true" : "false")
    sendEvent(name: "switch", value: anyMoving ? "on" : "off")
    
    def etaTop = (device.currentValue("etaTop") ?: 0) as Integer
    def etaBottom = (device.currentValue("etaBottom") ?: 0) as Integer
    sendEvent(name: "eta", value: anyMoving ? Math.max(etaTop, etaBottom) : 0)
}

def interpolateTDBUPosition() {
    def topState = state.tdbuMovementState?.top
    def bottomState = state.tdbuMovementState?.bottom
    def hasMovement = (topState?.isMoving || bottomState?.isMoving)

    if (!hasMovement) return

    def newPosTop = null
    def newPosBottom = null

    if (topState?.isMoving) {
        def elapsed = (now() - (topState.startTime as long)) as long
        if (elapsed >= (topState.estimatedDuration as long)) {
            newPosTop = topState.targetPosition as Integer
            stopTDBUMovementTracking("top")
        } else {
            def progress = ((elapsed as double) / (topState.estimatedDuration as double))
            newPosTop = Math.round(topState.startPosition + ((topState.targetPosition - topState.startPosition) * progress)) as Integer
            newPosTop = Math.min(100, Math.max(0, newPosTop)) as Integer
        }
    }

    if (bottomState?.isMoving) {
        def elapsed = (now() - (bottomState.startTime as long)) as long
        if (elapsed >= (bottomState.estimatedDuration as long)) {
            newPosBottom = bottomState.targetPosition as Integer
            stopTDBUMovementTracking("bottom")
        } else {
            def progress = ((elapsed as double) / (bottomState.estimatedDuration as double))
            newPosBottom = Math.round(bottomState.startPosition + ((bottomState.targetPosition - bottomState.startPosition) * progress)) as Integer
            newPosBottom = Math.min(100, Math.max(0, newPosBottom)) as Integer
        }
    }

    if (newPosTop != null) {
        sendEvent(name: "levelTop", value: newPosTop)
        sendEvent(name: "positionTop", value: newPosTop)
    }
    if (newPosBottom != null) {
        sendEvent(name: "levelBottom", value: newPosBottom)
        sendEvent(name: "positionBottom", value: newPosBottom)
    }

    if (newPosTop != null || newPosBottom != null) {
        def avgTop = (newPosTop ?: (device.currentValue("levelTop") ?: 0)) as Integer
        def avgBottom = (newPosBottom ?: (device.currentValue("levelBottom") ?: 0)) as Integer
        def avgPos = (((avgTop + avgBottom) / 2) as double) as Integer
        sendEvent(name: "level", value: avgPos)
        sendEvent(name: "position", value: avgPos)
        updateWindowShadeState(avgPos)
    }

    if (hasMovement) {
        runInMillis(interpolationInterval * 1000, "interpolateTDBUPosition")
    }
}

def updateWindowShadeState(Integer position) {
    position = position ?: 0
    def shadeValue
    // Hubitat logic: 100=Open, 0=Closed
    if (position == 100) {
        shadeValue = "open"
    } else if (position == 0) {
        shadeValue = "closed"
    } else {
        shadeValue = "partially open"
    }
    
    def currentShade = device.currentValue("windowShade")
    if (currentShade != shadeValue) {
        sendEvent(name: "windowShade", value: shadeValue)
    }
}

/* --------------------------------------------------
TDBU COMMANDS
-------------------------------------------------- */
def setTDBUPosition(positionTop, positionBottom) {
    // INVERT: Convert Hubitat positions to Bridge positions
    def posT = invertIfNeeded(positionTop as Integer)
    def posB = invertIfNeeded(positionBottom as Integer)
    posT = Math.min(100, Math.max(0, posT)) as Integer
    posB = Math.min(100, Math.max(0, posB)) as Integer

    logDebug "Setting TDBU position - Top: ${posT}, Bottom: ${posB} (Invert: ${invertPosition})"
    parent?.sendChildTDBUPosition(device.deviceNetworkId, posT, posB)
}

def setTopPosition(position) {
    def pos = invertIfNeeded(position as Integer)
    pos = Math.min(100, Math.max(0, pos)) as Integer
    def currentBottom = (device.currentValue("levelBottom") ?: 0) as Integer
    logDebug "Setting top position to ${pos}"
    setTDBUPosition(pos, currentBottom)
}

def setBottomPosition(position) {
    def pos = invertIfNeeded(position as Integer)
    pos = Math.min(100, Math.max(0, pos)) as Integer
    def currentTop = (device.currentValue("levelTop") ?: 0) as Integer
    logDebug "Setting bottom position to ${pos}"
    setTDBUPosition(currentTop, pos)
}

def setPosition(position) {
    def pos = position as Integer
    pos = Math.min(100, Math.max(0, pos)) as Integer
    logDebug "Setting TDBU position (both) to ${pos}"
    setTDBUPosition(pos, pos)
}

def openTop() {
    logDebug "Opening top"
    startTDBUMovementTracking("top", "open")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 1, 2, true, false)
}

def closeTop() {
    logDebug "Closing top"
    startTDBUMovementTracking("top", "close")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 0, 2, true, false)
}

def stopTop() {
    logDebug "Stopping top"
    stopTDBUMovementTracking("top")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 2, 2, true, false)
}

def openBottom() {
    logDebug "Opening bottom"
    startTDBUMovementTracking("bottom", "open")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 2, 1, false, true)
}

def closeBottom() {
    logDebug "Closing bottom"
    startTDBUMovementTracking("bottom", "close")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 2, 0, false, true)
}

def stopBottom() {
    logDebug "Stopping bottom"
    stopTDBUMovementTracking("bottom")
    parent?.sendChildTDBUOperation(device.deviceNetworkId, 2, 2, false, true)
}

def refresh() {
    logDebug "Refreshing device status"
    parent?.refreshChild(device.deviceNetworkId)
}

/* --------------------------------------------------
EXTERNAL STATUS UPDATE HANDLER
-------------------------------------------------- */
def updateStatus(Map data) {
    // TDBU positions (invert for Hubitat if enabled)
    if (data.currentPosition_T != null) {
        def hubitatTop = invertIfNeeded(data.currentPosition_T as Integer)
        sendEvent(name: "levelTop", value: hubitatTop)
        sendEvent(name: "positionTop", value: hubitatTop)
    }
    if (data.currentPosition_B != null) {
        def hubitatBottom = invertIfNeeded(data.currentPosition_B as Integer)
        sendEvent(name: "levelBottom", value: hubitatBottom)
        sendEvent(name: "positionBottom", value: hubitatBottom)
    }

    // Update combined level/position for Easy Dashboard
    def currentTop = (device.currentValue("levelTop") ?: 0) as Integer
    def currentBottom = (device.currentValue("levelBottom") ?: 0) as Integer
    def avgPos = (((currentTop + currentBottom) / 2) as double) as Integer
    sendEvent(name: "level", value: avgPos)
    sendEvent(name: "position", value: avgPos)
    updateWindowShadeState(avgPos)

    // Battery handling - FIX: Explicit type casting for DD7002B compatibility
    if (data.batteryLevel_T != null) {
        def batteryLevelTopVal = data.batteryLevel_T as Integer
        sendEvent(name: "batteryLevelTop", value: batteryLevelTopVal)
    }
    if (data.batteryLevel_B != null) {
        def batteryLevelBottomVal = data.batteryLevel_B as Integer
        sendEvent(name: "batteryLevelBottom", value: batteryLevelBottomVal)
    }
    
    def batTop = (data.batteryLevel_T ?: device.currentValue("batteryLevelTop") ?: 700) as Integer
    def batBottom = (data.batteryLevel_B ?: device.currentValue("batteryLevelBottom") ?: 700) as Integer
    def avgBattery = (((batTop + batBottom) / 2) as double) as Integer
    sendEvent(name: "batteryLevel", value: avgBattery)
    // FIX: Use 150.0 for floating-point division and proper casting
    def batteryPercent = Math.min(100, Math.max(0, ((((avgBattery - 700) as double) / 150.0 * 100) as Integer)))
    sendEvent(name: "battery", value: batteryPercent)
    
    if (data.RSSI != null) {
        sendEvent(name: "rssi", value: data.RSSI)
    }
}

/* --------------------------------------------------
HELPER METHODS
-------------------------------------------------- */
def getBlindTypeName() {
    return device.getDataValue("blindTypeName") ?: "TDBU"
}

/* --------------------------------------------------
LOGGING HELPERS
-------------------------------------------------- */
private logInfo(msg) {
    log.info "[Child ${device.deviceNetworkId}] ${msg}"
}

private logDebug(msg) {
    if (debugLogging) log.debug "[Child ${device.deviceNetworkId}] ${msg}"
}

private logWarn(msg) {
    log.warn "[Child ${device.deviceNetworkId}] ${msg}"
}

private logError(msg, ex = null) {
    log.error "[Child ${device.deviceNetworkId}] ${msg}"
    if (ex) log.exception("Error details", ex)
}
