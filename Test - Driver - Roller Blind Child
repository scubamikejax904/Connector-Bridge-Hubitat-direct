/**
 * Connector Roller Blind Child Driver
 * For: Roller Blinds (1), Roller Shutter (6), Roman (3), Honeycomb (4), 
 *      Shangri-La (5), Roller Gate (7), Awning (8), Day&Night (10), 
 *      Dimming (11), Curtain (12,13)
 * 
 * Commands: Position ONLY (no angle, no TDBU)
 * - Bridge: 0=Open, 100=Closed (typically)
 * - Hubitat: 0=Closed, 100=Open (standard)
 * - Invert preference allows matching your hardware
 *
 *RCv19
 */
metadata {
    definition(name: "Connector Roller Blind Child", 
               namespace: "connector", 
               author: "Scubamikejax904 & Manus"
               //importUrl: "update link"
              ) 
    {
        capability "WindowShade"
        capability "WindowBlind"
        capability "Actuator"
        capability "Refresh"
        capability "Battery"
        capability "SignalStrength"

        command "setPosition", [[name: "position", type: "NUMBER", description: "Position 0-100"]]
        command "startPositionChange", [[name: "direction", type: "STRING", description: "Direction: 'open' or 'close'"]]
        command "stopPositionChange"

        attribute "windowShade", "enum", ["open", "closed", "partially open", "unknown"]
        attribute "windowBlind", "enum", ["open", "closed", "partially open", "unknown"]
        attribute "level", "number"
        attribute "position", "number"
        attribute "moving", "enum", ["true", "false"]
        attribute "direction", "string"
        attribute "eta", "number"
        attribute "targetPosition", "number"
        attribute "lastPosition", "number"
        attribute "lastSeen", "string"
        attribute "operation", "string"
        attribute "limitState", "string"
        attribute "rssi", "number"
        attribute "batteryLevel", "number"
        attribute "chargingState", "string"
        attribute "blindTypeName", "string"
        attribute "voltageModeName", "string"
        attribute "wirelessModeName", "string"
    }

    preferences {
        input name: "presetPosition", type: "number", title: "Preset Position (0-100)", defaultValue: 50, range: "0..100"
        input name: "fullTravelTime", type: "number", title: "Full Travel Time (seconds for 0↔100)", defaultValue: 30, range: "5..300"
        input name: "interpolationEnabled", type: "bool", title: "Enable Position Interpolation", defaultValue: true
        input name: "interpolationInterval", type: "number", title: "Interpolation Update Interval (seconds)", defaultValue: 1, range: "1..10"
        input name: "invertPosition", type: "bool", title: "Invert Position (Bridge 0=Open, Hubitat 0=Closed)", defaultValue: true, description: "Enable if bridge 0=fully open, 100=fully closed"
        input name: "debugLogging", type: "bool", title: "Enable Debug Logging", defaultValue: false
    }
}

/* -------------------------------------------------- */
def installed() {
    logInfo "Child device installed"
    initialize()
}

def updated() {
    logInfo "Child device updated"
    initialize()
}

def initialize() {
    sendEvent(name: "windowShade", value: "unknown")
    sendEvent(name: "windowBlind", value: "unknown")
    sendEvent(name: "level", value: 0)
    sendEvent(name: "position", value: 0)
    sendEvent(name: "moving", value: "false")
    sendEvent(name: "direction", value: "none")

    state.movementState = [
        isMoving: false,
        direction: null,
        startPosition: null,
        targetPosition: null,
        startTime: null,
        estimatedDuration: null,
        distance: null
    ]
    
    logInfo "Initialized with Full Travel Time: ${fullTravelTime}s, Invert: ${invertPosition}"
}

/* --------------------------------------------------
   POSITION INVERSION HELPER
-------------------------------------------------- */
private Integer invertIfNeeded(Integer position) {
    if (position == null) return null
    return invertPosition ? (100 - position) : position
}

/* --------------------------------------------------
   MOVEMENT TRACKING & INTERPOLATION
-------------------------------------------------- */
def startMovementTracking(String direction, Integer targetPos = null) {
    if (!interpolationEnabled) return

    def currentPos = device.currentValue("level") ?: 0
    targetPos = targetPos ?: ((direction == "open") ? 100 : 0)  // Hubitat: 100=Open, 0=Closed
    
    def distance = Math.abs(targetPos - currentPos)
    def estimatedDuration = (distance > 0) ? (fullTravelTime * (distance / 100.0) * 1000) : 0
    estimatedDuration = Math.max(1000, estimatedDuration)

    state.movementState = [
        isMoving: true,
        direction: direction,
        startPosition: currentPos,
        targetPosition: targetPos,
        startTime: now(),
        estimatedDuration: estimatedDuration,
        distance: distance
    ]

    sendEvent(name: "moving", value: "true")
    sendEvent(name: "direction", value: direction)
    sendEvent(name: "targetPosition", value: targetPos)
    sendEvent(name: "lastPosition", value: currentPos)
    sendEvent(name: "eta", value: (estimatedDuration / 1000) as Integer)

    logInfo "Movement tracking: ${direction} from ${currentPos} to ${targetPos} (${distance} units, est. ${(estimatedDuration/1000)}s)"

    unschedule("interpolatePosition")
    runInMillis(interpolationInterval * 1000, "interpolatePosition")
}

def stopMovementTracking(Integer finalPosition = null) {
    unschedule("interpolatePosition")

    def wasMoving = state.movementState?.isMoving ?: false
    
    if (finalPosition == null) {
        finalPosition = state.movementState?.targetPosition ?: 
                        device.currentValue("level") ?: 
                        state.movementState?.startPosition ?: 0
    }

    state.movementState = [
        isMoving: false,
        direction: null,
        startPosition: null,
        targetPosition: null,
        startTime: null,
        estimatedDuration: null,
        distance: null
    ]

    sendEvent(name: "moving", value: "false")
    sendEvent(name: "direction", value: "none")
    sendEvent(name: "eta", value: 0)

    sendEvent(name: "level", value: finalPosition)
    sendEvent(name: "position", value: finalPosition)
    updateWindowShadeState(finalPosition)

    if (wasMoving) {
        logInfo "Movement tracking stopped at position: ${finalPosition}"
    }
    
    runIn(2, "refresh")
}

def interpolatePosition() {
    def moveState = state.movementState
    if (!moveState?.isMoving) return

    def elapsed = now() - moveState.startTime
    def duration = moveState.estimatedDuration
    def start = moveState.startPosition
    def target = moveState.targetPosition

    if (elapsed >= duration) {
        logInfo "Interpolation complete, finalizing position at ${target}"
        stopMovementTracking(target)
        return
    }

    def progress = elapsed / duration
    def interpolatedPos = Math.round(start + ((target - start) * progress)) as Integer
    interpolatedPos = Math.min(100, Math.max(0, interpolatedPos))
    
    def remainingSeconds = Math.round((duration - elapsed) / 1000)
    
    sendEvent(name: "level", value: interpolatedPos)
    sendEvent(name: "position", value: interpolatedPos)
    sendEvent(name: "eta", value: remainingSeconds)
    updateWindowShadeState(interpolatedPos)
    
    runInMillis(interpolationInterval * 1000, "interpolatePosition")
}

def updateWindowShadeState(Integer position) {
    position = position ?: 0
    def shadeValue
    // Hubitat Standard: 100=Open, 0=Closed
    if (position == 100) {
        shadeValue = "open"
    } else if (position == 0) {
        shadeValue = "closed"
    } else {
        shadeValue = "partially open"
    }
    
    def currentShade = device.currentValue("windowShade")
    if (currentShade != shadeValue) {
        sendEvent(name: "windowShade", value: shadeValue)
        sendEvent(name: "windowBlind", value: shadeValue)
    }
}

/* --------------------------------------------------
   STANDARD WINDOWSHADE CAPABILITY COMMANDS
-------------------------------------------------- */
def open() {
    logInfo "Open command received"
    startMovementTracking("open")
    parent?.sendChildOpen(device.deviceNetworkId)
}

def close() {
    logInfo "Close command received"
    startMovementTracking("close")
    parent?.sendChildClose(device.deviceNetworkId)
}

def stop() {
    logInfo "Stop command received - current level: ${device.currentValue('level') ?: 'unknown'}"
    stopMovementTracking()
    parent?.sendChildStop(device.deviceNetworkId)
}

def refresh() {
    logDebug "Refreshing device status"
    parent?.refreshChild(device.deviceNetworkId)
}

def setPosition(position) {
    def hubitatPos = position as Integer
    hubitatPos = Math.min(100, Math.max(0, hubitatPos))
    
    // Invert Hubitat Level to Bridge Position if enabled
    def bridgePos = invertIfNeeded(hubitatPos)
    
    def currentPos = device.currentValue("level") ?: 0
    def direction = (hubitatPos > currentPos) ? "open" : "close"

    logInfo "Setting position to ${hubitatPos} (Bridge: ${bridgePos}, direction: ${direction})"
    startMovementTracking(direction, hubitatPos)
    parent?.sendChildCommand(device.deviceNetworkId, bridgePos)
}

def startPositionChange(String direction) {
    logDebug "Starting position change: ${direction}"
    startMovementTracking(direction)

    if (direction == "open") {
        parent?.sendChildOpen(device.deviceNetworkId)
    } else if (direction == "close") {
        parent?.sendChildClose(device.deviceNetworkId)
    }
}

def stopPositionChange() {
    logDebug "Stopping position change"
    stopMovementTracking()
    parent?.sendChildStop(device.deviceNetworkId)
}

def presetPosition() {
    setPosition(presetPosition ?: 50)
}

/* --------------------------------------------------
   EXTERNAL STATUS UPDATE HANDLER
-------------------------------------------------- */
def updateStatus(Map data) {
    def reportedPos = data.currentPosition ?: data.position ?: data.level
    
    if (reportedPos != null) {
        // Invert Bridge Position to Hubitat Level if enabled
        def hubitatLevel = invertIfNeeded(reportedPos as Integer)
        logDebug "Status update: Bridge=${reportedPos} → Hubitat=${hubitatLevel}"
        stopMovementTracking(hubitatLevel)
    } else {
        logDebug "Status update without position field, keys: ${data.keySet()}"
        stopMovementTracking(null)
    }

    if (data.currentAngle != null) {
        sendEvent(name: "angle", value: data.currentAngle as Integer)
    }
    if (data.batteryLevel != null) {
        sendEvent(name: "batteryLevel", value: data.batteryLevel)
        def batteryPercent = Math.min(100, Math.max(0, ((data.batteryLevel - 700) / 150 * 100) as Integer))
        sendEvent(name: "battery", value: batteryPercent)
    }
    if (data.RSSI != null) {
        sendEvent(name: "rssi", value: data.RSSI)
    }
}

/* --------------------------------------------------
   HELPER METHODS
-------------------------------------------------- */
def getBlindTypeName() {
    return device.getDataValue("blindTypeName") ?: "Unknown"
}

/* --------------------------------------------------
   LOGGING HELPERS
-------------------------------------------------- */
private logInfo(msg) {
    log.info "[Child ${device.deviceNetworkId}] ${msg}"
}

private logDebug(msg) {
    if (debugLogging) log.debug "[Child ${device.deviceNetworkId}] ${msg}"
}

private logWarn(msg) {
    log.warn "[Child ${device.deviceNetworkId}] ${msg}"
}

private logError(msg, ex = null) {
    log.error "[Child ${device.deviceNetworkId}] ${msg}"
    if (ex) log.exception("Error details", ex)
}
